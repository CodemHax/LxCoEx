# Core API Settings
PROJECT_NAME="LiCoEx API"
API_V1_STR="/api/v1"

# Database Connections
MONGODB_URL="mongodb://localhost:27017"
MONGODB_DB_NAME="licoex_db"
REDIS_URL="redis://localhost:6379"

# Execution Engine configuration
EXECUTION_TMP_DIR=
EXECUTION_COMPILE_TIMEOUT_MS=10000
EXECUTION_MAX_OUTPUT_BYTES=32768

# Docker Sandbox Settings
EXECUTION_DOCKER_BINARY="docker"
EXECUTION_SANDBOX_IMAGE="licoex-sandbox:latest"
EXECUTION_SANDBOX_UID=65534
EXECUTION_SANDBOX_GID=65534
EXECUTION_SANDBOX_MEMORY="256m"
EXECUTION_SANDBOX_MEMORY_SWAP="256m"
EXECUTION_SANDBOX_CPUS=1.0
EXECUTION_SANDBOX_PIDS_LIMIT=64
EXECUTION_SANDBOX_NOFILE=64
EXECUTION_SANDBOX_FSIZE=1048576
EXECUTION_SANDBOX_TMP_SIZE="64m"
EXECUTION_SANDBOX_INPUT_SIZE="16m"
EXECUTION_SANDBOX_WORKSPACE_SIZE="128m"
